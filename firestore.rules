rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function approved() {
      return googleUser()
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower())).data.enabled == true;
    }
    match /allowedUsers/{email} {
      allow get: if googleUser() && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }
    match /songs/{songId} {
      allow read: if approved();
      allow write: if false;
    }
    match /catalog/{document} {
      allow read: if approved();
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
