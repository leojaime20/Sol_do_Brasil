{
  "name": "sol-do-brasil",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:pages": "GITHUB_PAGES=1 npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "catalog:validate": "node scripts/import-catalog.mjs --validate",
    "catalog:import": "node scripts/import-catalog.mjs",
    "access": "node scripts/manage-access.mjs",
    "deploy": "npm run build && firebase deploy --only auth,firestore,hosting",
    "test:rules": "node scripts/test-rules.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "csv-parse": "^6.0.0",
    "firebase-tools": "^15.35.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "engines": {
    "node": ">=22"
  }
}
